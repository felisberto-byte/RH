# Copie para .env (desenvolvimento) ou cadastre no Cloud Run/Secret Manager (produção).
# Variáveis marcadas [SEGREDO] devem vir do Secret Manager.

PORTAL_ENV=dev                          # dev | test | prod
PORTAL_BASE_URL=http://localhost:8000   # em produção: https://portal.suaempresa.com.br
PORTAL_SECRET_KEY=                      # [SEGREDO] >= 32 caracteres aleatórios
PORTAL_COMPANY_NAME=Empresa Exemplo Ltda
PORTAL_COMPANY_CNPJ=00.000.000/0001-00
PORTAL_TIMEZONE=America/Sao_Paulo

# Banco (Cloud SQL PostgreSQL via IP privado em produção)
PORTAL_DATABASE_URL=sqlite:///var/portal.sqlite3
# PORTAL_DATABASE_URL=postgresql+psycopg://portal:SENHA@10.x.x.x/portal   # [SEGREDO]

# Armazenamento dos PDFs
PORTAL_STORAGE_BACKEND=local            # local | gcs
PORTAL_STORAGE_LOCAL_PATH=var/storage
PORTAL_STORAGE_GCS_BUCKET=              # bucket com retention policy (Bucket Lock)

# Autenticação
PORTAL_AUTH_PROVIDER=dev                # ldap (produção) | dev (apenas local)
PORTAL_SESSION_IDLE_MINUTES=30
PORTAL_SESSION_ABSOLUTE_HOURS=8
PORTAL_LOGIN_MAX_FAILURES=5             # mantenha ABAIXO do limite de bloqueio do AD
PORTAL_LOGIN_LOCKOUT_MINUTES=15
PORTAL_TRUSTED_PROXY_HOPS=0             # Cloud Run direto: 1 · Cloud Run atrás de LB externo: 2

# Active Directory via LDAPS (através da VPN GCP <-> rede local)
PORTAL_LDAP_URL=ldaps://dc01.empresa.local:636
PORTAL_LDAP_CA_CERT_FILE=/secrets/ad-ca.pem
PORTAL_LDAP_BIND_DN=CN=svc-portal,OU=Servicos,DC=empresa,DC=local
PORTAL_LDAP_BIND_PASSWORD=              # [SEGREDO] conta de serviço somente leitura
PORTAL_LDAP_BASE_DN=OU=Usuarios,DC=empresa,DC=local
PORTAL_LDAP_EMPLOYEE_ID_ATTR=employeeNumber  # atributo com a matrícula (employeeID só aceita 16 caracteres)
PORTAL_LDAP_TLS_VALID_NAMES=[]          # JSON, ex.: ["dc01.empresa.local"] ao conectar por IP
PORTAL_LDAP_GROUP_USERS_DN=CN=GG_Portal_Colaboradores,OU=Grupos,DC=empresa,DC=local
PORTAL_LDAP_GROUP_ADMIN_DN=CN=GG_Portal_RH,OU=Grupos,DC=empresa,DC=local

# Assinatura: e-CNPJ A1 (PKCS#12) — montar o .pfx a partir do Secret Manager
PORTAL_SIGNING_PFX_FILE=/secrets/ecnpj.pfx
PORTAL_SIGNING_PFX_PASSWORD=            # [SEGREDO]
PORTAL_SIGNING_CA_CHAIN_FILES=[]        # JSON: ["/certs/ac-intermediaria.pem", ...]
PORTAL_SIGNING_LOCATION=São Paulo/SP
# Carimbo do tempo RFC 3161 (recomendado: ACT credenciada ICP-Brasil)
PORTAL_TSA_URL=
PORTAL_TSA_USERNAME=
PORTAL_TSA_PASSWORD=                    # [SEGREDO]
# Política de assinatura ICP-Brasil (opcional; tabela de OIDs/hashes em
# docs/assinatura-e-validade-juridica.md — escolha a versão conforme a raiz do certificado)
PORTAL_SIGNATURE_POLICY_OID=            # ex.: 2.16.76.1.7.1.11.1.1 (PAdES AD-RB v1.1, cadeia v5)
PORTAL_SIGNATURE_POLICY_HASH_B64=       # hex (como na LPA) ou base64 do SHA-256 do .der da política
PORTAL_SIGNATURE_POLICY_URI=            # URL do .der da política no repositório do ITI

# Aceite
PORTAL_ACCEPT_REAUTH=password           # obrigatório "password" em produção
PORTAL_REQUIRE_VIEW_BEFORE_ACCEPT=true
PORTAL_PUBLIC_VERIFICATION=true

# DocuSeal (opcional — somente modelos fixos, ex.: contratos)
PORTAL_DOCUSEAL_ENABLED=false
PORTAL_DOCUSEAL_URL=https://assinatura.suaempresa.com.br
PORTAL_DOCUSEAL_API_TOKEN=              # [SEGREDO]
PORTAL_DOCUSEAL_WEBHOOK_SECRET=         # [SEGREDO] segredo HMAC do webhook (whsec_...)

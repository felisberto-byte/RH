# Configuração do Portal do Colaborador.
# Desenvolvimento: copie para .env. Produção: variáveis do Cloud Run, com os
# itens marcados [SEGREDO] vindos do Secret Manager (ver infra/terraform).
# Comentários ficam SEMPRE em linha própria (docker --env-file não remove
# comentários no fim da linha). Linhas "# PORTAL_X=" mostram o padrão.

# ---------------------------------------------------------------- geral
# dev | test | prod
PORTAL_ENV=dev
# Produção: https://portal.suaempresa.com.br
PORTAL_BASE_URL=http://localhost:8000
# [SEGREDO] Em produção: 32+ caracteres aleatórios (python -c "import secrets; print(secrets.token_urlsafe(48))")
PORTAL_SECRET_KEY=dev-somente-local
PORTAL_COMPANY_NAME=Empresa Exemplo Ltda
PORTAL_COMPANY_CNPJ=00.000.000/0001-00
PORTAL_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------- banco
# Produção (obrigatório PostgreSQL): postgresql+psycopg://portal_app:SENHA@10.x.x.x/portal?sslmode=require [SEGREDO]
PORTAL_DATABASE_URL=sqlite:///var/portal.sqlite3

# ------------------------------------------------- armazenamento dos PDFs
# local | gcs
PORTAL_STORAGE_BACKEND=local
PORTAL_STORAGE_LOCAL_PATH=var/storage
# Bucket com política de retenção (Bucket Lock) quando STORAGE_BACKEND=gcs
PORTAL_STORAGE_GCS_BUCKET=

# --------------------------------------------------------- autenticação
# ldap (produção) | dev (apenas local; proibido em produção)
PORTAL_AUTH_PROVIDER=dev
PORTAL_SESSION_IDLE_MINUTES=30
PORTAL_SESSION_ABSOLUTE_HOURS=8
# Revalida a conta no AD (habilitada, grupos, vínculo) a cada N minutos
PORTAL_SESSION_REVALIDATE_MINUTES=10
# Falhas por CONTA antes do bloqueio temporário: mantenha ABAIXO do limite do AD
PORTAL_LOGIN_MAX_FAILURES=5
# Falhas de login por IP (alto o bastante para o NAT do escritório)
PORTAL_LOGIN_MAX_FAILURES_PER_IP=50
# Janela do bloqueio: >= "Redefinir contador de bloqueio após" do AD
PORTAL_LOGIN_LOCKOUT_MINUTES=15
# Proxies confiáveis à frente do app: 0 local · 1 Cloud Run direto · 2 LB externo + Cloud Run
PORTAL_TRUSTED_PROXY_HOPS=0
# Cabeçalho com a porta de origem do cliente, se o proxy fornecer (Marco Civil art. 10 §1º)
PORTAL_CLIENT_PORT_HEADER=

# ------------------------------------------- Active Directory (LDAPS via VPN)
PORTAL_LDAP_URL=ldaps://dc01.empresa.local:636
# PEM da AC que emitiu o certificado LDAPS dos controladores de domínio
# PORTAL_LDAP_CA_CERT_FILE=/secrets/ad-ca/ad-ca.pem
PORTAL_LDAP_BIND_DN=CN=svc-portal,OU=Servicos,DC=empresa,DC=local
# [SEGREDO] conta de serviço somente leitura
PORTAL_LDAP_BIND_PASSWORD=
PORTAL_LDAP_BASE_DN=OU=Usuarios,DC=empresa,DC=local
# Filtro de busca (padrão abaixo; {username} é escapado pelo portal)
# PORTAL_LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user)(|(sAMAccountName={username})(userPrincipalName={username})))
# Atributo com a matrícula (employeeID aceita só 16 caracteres)
PORTAL_LDAP_EMPLOYEE_ID_ATTR=employeeNumber
# JSON. Nomes aceitos no certificado do DC ao conectar por IP, ex.: ["dc01.empresa.local"]
PORTAL_LDAP_TLS_VALID_NAMES=[]
PORTAL_LDAP_GROUP_USERS_DN=CN=GG_Portal_Colaboradores,OU=Grupos,DC=empresa,DC=local
PORTAL_LDAP_GROUP_ADMIN_DN=CN=GG_Portal_RH,OU=Grupos,DC=empresa,DC=local
PORTAL_LDAP_TIMEOUT_SECONDS=5

# ------------------------------------------- selo da empresa (e-CNPJ A1)
# PKCS#12 montado a partir do Secret Manager. Dev: portal dev-cert var/dev
# PORTAL_SIGNING_PFX_FILE=/secrets/ecnpj/ecnpj.pfx
# [SEGREDO]
PORTAL_SIGNING_PFX_PASSWORD=
# JSON. Cadeia da AC emissora, se não estiver dentro do PFX
PORTAL_SIGNING_CA_CHAIN_FILES=[]
# JSON. Raízes ICP-Brasil (validação em /verificar, LTV, âncoras)
PORTAL_SIGNING_TRUST_ROOT_FILES=[]
PORTAL_SIGNING_LOCATION=São Paulo/SP
# Embute dados de validação (PAdES-LTA); exige TSA e raízes
PORTAL_SIGNING_LTV=false

# Carimbo do tempo RFC 3161 (ACT credenciada ICP-Brasil recomendada).
# Em produção é obrigatório, salvo PORTAL_ALLOW_NO_TSA=true (fica registrado na evidência).
PORTAL_TSA_URL=
PORTAL_TSA_USERNAME=
# [SEGREDO]
PORTAL_TSA_PASSWORD=
PORTAL_ALLOW_NO_TSA=false

# Política de assinatura ICP-Brasil (opcional; OIDs e hashes em
# docs/assinatura-e-validade-juridica.md, conforme a raiz do certificado)
# Ex.: 2.16.76.1.7.1.11.1.1 (PAdES AD-RB v1.1, cadeia v5)
PORTAL_SIGNATURE_POLICY_OID=
# Hash do .der da política: hex (como na LPA) ou base64
PORTAL_SIGNATURE_POLICY_HASH_B64=
PORTAL_SIGNATURE_POLICY_HASH_ALG=sha256
PORTAL_SIGNATURE_POLICY_URI=

# ----------------------------------------------------- manifestação
# Obrigatório "password" em produção (confirmação com a senha do AD)
PORTAL_ACCEPT_REAUTH=password
# Segundo fator no ato: none | totp (recomendado em produção)
PORTAL_ACCEPT_MFA=none
PORTAL_TOTP_ISSUER=Portal do Colaborador
PORTAL_REQUIRE_ADHESION_TERM=true
PORTAL_REQUIRE_VIEW_BEFORE_ACCEPT=true
PORTAL_PUBLIC_VERIFICATION=true

# ------------------------------- DocuSeal (opcional; modelos fixos, ex.: contratos)
PORTAL_DOCUSEAL_ENABLED=false
PORTAL_DOCUSEAL_URL=
# [SEGREDO]
PORTAL_DOCUSEAL_API_TOKEN=
# [SEGREDO] segredo HMAC do webhook
PORTAL_DOCUSEAL_WEBHOOK_SECRET=

# ------------------------------------------------------------ logs
# json (Cloud Logging; padrão em produção) | text
# PORTAL_LOG_FORMAT=text
